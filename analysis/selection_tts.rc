#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_TEXT_FILTERS DIALOGEX 0, 0, 310, 199
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Text filters"
FONT 9, "Segoe UI"
BEGIN
  CONTROL "Enable text filters", IDC_FILTER_ENABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 10, 180, 12
  LTEXT "One regex per line (ECMAScript). Matches are skipped.", -1, 12, 30, 286, 12
  EDITTEXT IDC_FILTER_REGEX, 12, 46, 286, 94, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
  LTEXT "Defaults: \\* skips asterisks; \\[\\d+\\] skips [number].", -1, 12, 146, 286, 20
  PUSHBUTTON "Restore defaults", IDC_FILTER_DEFAULTS, 12, 175, 102, 16
  DEFPUSHBUTTON "OK", IDOK, 192, 175, 50, 16
  PUSHBUTTON "Cancel", IDCANCEL, 248, 175, 50, 16
END

IDD_SPEECH_SPEED DIALOGEX 0, 0, 310, 130
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Speech speed"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Speed: 0 (normal)", IDC_SPEED_VALUE, 12, 12, 286, 14
  CONTROL "", IDC_SPEED_SLIDER, "msctls_trackbar32", TBS_AUTOTICKS | TBS_TOOLTIPS | WS_TABSTOP, 12, 32, 286, 28
  LTEXT "-10  Slower", -1, 12, 64, 84, 12
  CTEXT "0  Normal", -1, 113, 64, 84, 12
  RTEXT "10  Faster", -1, 214, 64, 84, 12
  LTEXT "OK saves the speed. Cancel restores the previous value.", -1, 12, 83, 286, 12
  PUSHBUTTON "Normal speed", IDC_SPEED_NORMAL, 12, 106, 102, 16
  DEFPUSHBUTTON "OK", IDOK, 192, 106, 50, 16
  PUSHBUTTON "Cancel", IDCANCEL, 248, 106, 50, 16
END

1 VERSIONINFO
FILEVERSION 1,3,1,0
PRODUCTVERSION 1,3,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Korean-English TTS plugin for Notepad++\0"
      VALUE "FileVersion", "1.3.1\0"
      VALUE "InternalName", "KorEngTTS\0"
      VALUE "OriginalFilename", "KorEngTTS.dll\0"
      VALUE "ProductName", "KorEng TTS\0"
      VALUE "ProductVersion", "1.3.1\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
